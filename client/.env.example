# ---------------------------------------------------------------------------
# Client (VITE_* — inlined into the bundle at build time, so never secret)
# ---------------------------------------------------------------------------

# Which transport to connect with: smallwebrtc | daily. Defaults to
# smallwebrtc in dev (a bot on your machine) and daily in a production build
# (the Pipecat Cloud agent). Set daily to talk to the deployed agent from
# `npm run dev`.
# VITE_TRANSPORT=daily

# smallwebrtc only. The bot's WebRTC offer endpoint. Defaults to /api/offer,
# which the Vite dev server proxies to the bot on port 7860. Set an absolute
# URL for a build served away from the bot.
# VITE_OFFER_URL=https://bot.example.com/api/offer

# daily only. The endpoint that starts a Pipecat Cloud session; defaults to
# /api/start, served by api/start.ts (on Vercel, or by the Vite dev and
# preview servers locally).
# VITE_START_URL=/api/start

# ---------------------------------------------------------------------------
# Server (api/start.ts — no VITE_ prefix, so these stay out of the bundle)
# ---------------------------------------------------------------------------

# Full start endpoint for the deployed agent:
# https://api.pipecat.daily.co/v1/public/<agent-name>/start, where the agent
# name is agent_name in server/pcc-deploy.toml.
BOT_START_URL=https://api.pipecat.daily.co/v1/public/deepgram-webinar-demo/start

# Pipecat Cloud public API key, from `pipecat cloud organizations keys`.
# Secret: keep it in client/.env locally and in your host's environment
# variables when deployed — never in a VITE_ variable.
BOT_START_PUBLIC_KEY=pk_
