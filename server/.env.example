# Copy this file to .env and fill in your API keys.

# Deepgram — Flux speech-to-text and Flux text-to-speech
DEEPGRAM_API_KEY=
# Optional Flux voice (flux-{voice}-{language}); defaults to flux-heather-en
# DEEPGRAM_VOICE=flux-heather-en

# OpenAI — GPT-5.6 Luna over the Responses API
OPENAI_API_KEY=
# Optional model override; defaults to gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-luna

# Daily — only needed to run the Daily transport locally (`uv run bot.py -t daily`).
# Pipecat Cloud supplies the room itself.
# DAILY_API_KEY=
